# ============================================================
#  The Expert — example environment file
#  Copy this to `.env` and fill in your own values.
#  `.env` is gitignored and will NOT be committed.
# ============================================================
#
#  NEITHER edition requires a key in a file:
#   - Web edition: each user pastes their own key into the app;
#     it lives only in that browser's localStorage.
#   - Terminal edition: uses your Claude Code sign-in (no key).
#
#  This file exists only for optional local development, e.g. if
#  you want to run the terminal edition against a raw API key
#  instead of the subscription sign-in.

# Optional: a personal Anthropic API key for local dev only.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-REPLACE-WITH-YOUR-OWN-KEY

# Optional: turn the ambiguous-prompt Haiku classifier on/off (1/0)
ROUTER_USE_HAIKU=1
